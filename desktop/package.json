{
  "name": "smartvoiceinput-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "SmartVoiceInput 桌面语音输入",
  "author": "SmartVoiceInput",
  "repository": {
    "type": "git",
    "url": "https://github.com/uprxiao/SmartVoice.git"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "predev": "node scripts/build-voice-helper.mjs",
    "prebuild": "node scripts/build-voice-helper.mjs",
    "package": "node ../scripts/release/build.mjs --dir",
    "package:release": "node ../scripts/release/build.mjs",
    "test:release": "node --test ../scripts/release/release.test.mjs",
    "release:next": "node ../scripts/release/version.mjs",
    "release:check": "node ../scripts/release/metadata.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.564.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
