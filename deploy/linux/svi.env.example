# Copy to /etc/smartvoiceinput/svi.env (chmod 0640). Variable NAMES only; never commit values.
SVI_DATABASE_URL=
SVI_JWT_SECRET=
SVI_IDEMPOTENCY_SECRET=
# Provider key encryption (V2 §6.1): JSON map of key id -> base64(32 bytes); generate with
#   uv run --frozen python -m app.cli secrets generate-key
SVI_SECRET_KEYS=
SVI_SECRET_ACTIVE_KEY_ID=
# YAML fallback provider keys (referenced by asr.api_key_env / llm.api_key_env)
SVI_DASHSCOPE_API_KEY=
SVI_DEEPSEEK_API_KEY=
